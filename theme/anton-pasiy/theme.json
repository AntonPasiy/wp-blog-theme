{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "700px",
			"wideSize": "1340px"
		},
		"typography": {
			"fluid": false
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "19px",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "500",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "3.15rem",
					"fontWeight": "500",
					"lineHeight": "1.12"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "2rem",
					"fontWeight": "500",
					"lineHeight": "1.25"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.5rem",
					"fontWeight": "500",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.25rem",
					"fontWeight": "500",
					"lineHeight": "1.35"
				}
			}
		}
	}
}
