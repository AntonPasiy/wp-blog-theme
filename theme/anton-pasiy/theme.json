{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "920px",
			"wideSize": "920px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "10px",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "20px",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "30px",
					"slug": "40"
				},
				{
					"name": "Regular",
					"size": "clamp(30px, 5vw, 50px)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(30px, 7vw, 70px)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(50px, 7vw, 90px)",
					"slug": "70"
				},
				{
					"name": "XX-Large",
					"size": "clamp(70px, 10vw, 140px)",
					"slug": "80"
				},
				{
					"name": "8",
					"size": "0.5rem",
					"slug": "8"
				},
				{
					"name": "12",
					"size": "0.75rem",
					"slug": "12"
				},
				{
					"name": "16",
					"size": "1rem",
					"slug": "16"
				},
				{
					"name": "24",
					"size": "1.5rem",
					"slug": "24"
				},
				{
					"name": "32",
					"size": "2rem",
					"slug": "32"
				},
				{
					"name": "Page",
					"size": "clamp(1.5rem, 4vw, 2rem)",
					"slug": "page"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.125rem",
						"min": "1rem"
					},
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.375rem",
						"min": "1.125rem"
					},
					"name": "Large",
					"size": "1.38rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2rem",
						"min": "1.75rem"
					},
					"name": "Extra Large",
					"size": "1.75rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "3rem",
						"min": "2.15rem"
					},
					"name": "Extra Extra Large",
					"size": "2.15rem",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"max": "1.25rem",
						"min": "1.125rem"
					},
					"name": "Body",
					"size": "1.125rem",
					"slug": "body"
				},
				{
					"fluid": false,
					"name": "H4",
					"size": "1.25rem",
					"slug": "h4"
				},
				{
					"fluid": false,
					"name": "H3",
					"size": "1.375rem",
					"slug": "h3"
				},
				{
					"fluid": {
						"max": "1.75rem",
						"min": "1.5rem"
					},
					"name": "H2",
					"size": "1.5rem",
					"slug": "h2"
				},
				{
					"fluid": {
						"max": "2.5rem",
						"min": "2rem"
					},
					"name": "H1",
					"size": "2rem",
					"slug": "h1"
				}
			]
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "var:preset|spacing|16"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|manrope",
			"fontSize": "var:preset|font-size|body",
			"fontWeight": "400",
			"letterSpacing": "0px",
			"lineHeight": "1.65"
		},
		"elements": {
			"caption": {
				"color": {
					"text": "var:preset|color|accent-4"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400",
					"letterSpacing": "0px",
					"lineHeight": "1.45"
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "600",
					"letterSpacing": "0px",
					"lineHeight": "1.3"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-1)",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-2)",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.25"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-3)",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-4)",
					"lineHeight": "1.35"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "1.125rem",
					"letterSpacing": "0px",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"letterSpacing": "0.04em",
					"lineHeight": "1.4",
					"textTransform": "none"
				}
			},
			"link": {
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			}
		},
		"blocks": {
			"core/comment-author-name": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				},
				"color": {
					"text": "var:preset|color|contrast"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						}
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600"
				}
			},
			"core/comment-content": {
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|8",
						"bottom": "0"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				},
				"css": "& > *{margin-block:0}& > * + *{margin-block-start:var(--wp--preset--spacing--12)}"
			},
			"core/comments-pagination": {
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|24",
						"bottom": "0"
					}
				}
			},
			"core/post-comments-form": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|24",
						"bottom": "0"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				},
				"border": {
					"top": {
						"color": "var:preset|color|accent-6",
						"style": "solid",
						"width": "1px"
					}
				}
			},
			"core/code": {
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|16",
						"left": "var:preset|spacing|16",
						"right": "var:preset|spacing|16",
						"top": "var:preset|spacing|16"
					}
				},
				"typography": {
					"fontWeight": "400",
					"lineHeight": "1.6"
				}
			},
			"core/list": {
				"css": "& li{margin-block-start:0}& li+li{margin-block-start:var(--wp--preset--spacing--8)}"
			},
			"core/post-content": {
				"spacing": {
					"blockGap": "var:preset|spacing|16"
				}
			},
			"core/post-date": {
				"typography": {
					"fontWeight": "400",
					"letterSpacing": "0.01em",
					"lineHeight": "1.45"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontWeight": "400"
				}
			},
			"core/quote": {
				"spacing": {
					"blockGap": "var:preset|spacing|12",
					"padding": {
						"bottom": "var:preset|spacing|16",
						"left": "var:preset|spacing|24",
						"right": "var:preset|spacing|24",
						"top": "var:preset|spacing|16"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|body",
					"fontWeight": "400",
					"lineHeight": "1.65"
				}
			},
			"core/comments": {
				"border": {
					"top": {
						"color": "var:preset|color|accent-6",
						"style": "solid",
						"width": "1px"
					}
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|24"
					}
				}
			},
			"core/comment-date": {
				"color": {
					"text": "var:preset|color|accent-4"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|accent-4"
						}
					}
				}
			},
			"core/comment-reply-link": {
				"color": {
					"text": "var:preset|color|accent-4"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|accent-4"
						}
					}
				}
			},
			"core/comment-edit-link": {
				"color": {
					"text": "var:preset|color|accent-4"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|accent-4"
						}
					}
				}
			}
		},
		"css": "/* Корень даёт подвалу 16px сверху. Поле страницы уже стоит на внутренней группе, второй зазор не нужен. */\n.wp-site-blocks > footer.wp-block-template-part{margin-block-start:0}\n\n/* Карточка: дата с заголовком, заголовок с анонсом. Между карточками работает blockGap списка. */\n.wp-block-post-template > li > *{margin-block:0}\n.wp-block-post-template > li > .wp-block-post-date + .wp-block-post-title{margin-block-start:var(--wp--preset--spacing--8)}\n.wp-block-post-template > li > .wp-block-post-title + .wp-block-post-excerpt{margin-block-start:var(--wp--preset--spacing--12)}\n\n/* В записи дата принадлежит заголовку, а не обложке. */\nmain > .wp-block-post-title{margin-block:0}\nmain > .wp-block-post-title + .wp-block-post-date{margin-block-start:var(--wp--preset--spacing--8);margin-block-end:0}\n\n/* В статье один зазор на стыке. Перед заголовком больше, чем после. Соседний заголовок берёт свой отступ «до». */\n.wp-block-post-content.is-layout-constrained > h2 + *:not(h1, h2, h3, h4, h5, h6){margin-block-start:var(--wp--preset--spacing--12)}\n.wp-block-post-content.is-layout-constrained > :is(h3, h4, h5, h6) + *:not(h1, h2, h3, h4, h5, h6){margin-block-start:var(--wp--preset--spacing--8)}\n.wp-block-post-content.is-layout-constrained > * + h2{margin-block-start:var(--wp--preset--spacing--32)}\n.wp-block-post-content.is-layout-constrained > * + :is(h3, h4, h5, h6){margin-block-start:var(--wp--preset--spacing--24)}\n.wp-block-image .wp-element-caption{margin-block:var(--wp--preset--spacing--8) 0}\n\n/* Ссылка плагина — inline, её padding вылезает вверх и съедает зазор. */\n.wp-block-query > .wp-block-query-pagination,.wp-block-query > .wp-block-buttons{margin-block-start:var(--wp--preset--spacing--24)}\n.wp-load-more__button{display:inline-block}\n\n.wp-block-post-content a:where(:not(.wp-element-button)),\nmain > p a{text-underline-offset:0.18em}\n.wp-block-post-content a:where(:not(.wp-element-button)):hover,\nmain > p a:hover{color:var(--wp--preset--color--accent-4)}\na:focus-visible{outline:2px solid var(--wp--preset--color--contrast);outline-offset:3px}\n\n/* Комментарии: разделители, компактные ветки и форма без лишней линии в пустом обсуждении. */\n.wp-block-comment-template li + li{border-block-start:1px solid var(--wp--preset--color--accent-6);margin-block-start:var(--wp--preset--spacing--16);padding-block-start:var(--wp--preset--spacing--16)}\n.wp-block-comment-template .wp-block-avatar:empty{display:none}\n.wp-block-comment-template ol{border-inline-start:1px solid var(--wp--preset--color--accent-6);margin-block-start:var(--wp--preset--spacing--16);padding-inline-start:var(--wp--preset--spacing--16)}\n.wp-block-post-comments-form > .comment-reply-title{margin-block-start:0}\n.wp-block-comments h2 + .wp-block-post-comments-form{border-block-start:0;padding-block-start:0}\n@media(max-width:600px){.wp-block-post-comments-form .wp-block-button__link{font-size:var(--wp--preset--font-size--small);padding-inline:var(--wp--preset--spacing--16)}}\n"
	}
}
